# Segredos da rotina. Copie para `.env` e preencha — `.env` está no .gitignore.
# O `wyckoff` carrega este arquivo sozinho a cada comando; variável já exportada
# na sessão vence o que estiver aqui.
#
# Confira o que foi carregado com: wyckoff validate

# --- R9: notificação por Telegram -------------------------------------------
# Token: fale com o @BotFather no Telegram e crie um bot.
WYCKOFF_TELEGRAM_TOKEN=
# Chat: mande /start para o SEU bot e rode
#   curl -s "https://api.telegram.org/bot$WYCKOFF_TELEGRAM_TOKEN/getUpdates" \
#     | grep -o '"chat":{"id":[-0-9]*'
# (o bot não descobre o seu chat antes de você falar com ele; em grupo o id vem negativo)
WYCKOFF_TELEGRAM_CHAT_ID=

# --- R9: notificação por e-mail (alternativa ao Telegram) --------------------
# Use senha de APLICATIVO, nunca a senha da conta.
# WYCKOFF_SMTP_USER=
# WYCKOFF_SMTP_PASSWORD=

# --- P2: fonte alternativa da B3 --------------------------------------------
# Token gratuito em brapi.dev. Sem ele a fonte atende poucos papéis.
# WYCKOFF_BRAPI_TOKEN=
